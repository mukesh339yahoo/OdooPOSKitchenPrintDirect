<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Actionpad Override for Table Tent Button -->
    <t t-name="ridhira_pos_kitchen_print_direct.ActionpadWidget" t-inherit="point_of_sale.ActionpadWidget" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('actionpad')]" position="inside">
            <t t-if="this.pos.config.pos_enable_table_tent">
                <button class="button pay validation btn btn-secondary btn-lg py-2 mt-1" t-on-click="assignTableTent">
                    <i class="fa fa-map-marker"/> Assign Table Tent
                </button>
            </t>
        </xpath>
    </t>
</templates>
