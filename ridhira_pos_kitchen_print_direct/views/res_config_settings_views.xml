<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ridhira.pos.kitchen.print.direct</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_connected_devices_section']" position="inside">
                <setting string="Direct Kitchen Print Proxy" help="Configure your SaaS Proxy API Key to enable Kitchen Printing without an IoT Box.">
                    <field name="ridhira_kitchen_print_api_key" placeholder="Enter your API Key..."/>
                    <div class="mt8">
                        <a href="https://ridhira.desigoogly.com/" target="_blank" class="btn-link">
                            <i class="fa fa-arrow-right"/> Get your API Key (30-Day Free Trial)
                        </a>
                    </div>
                </setting>
                <setting string="Split Combos to Respective Printers" help="If enabled, Combo items (like Burger + Coke) will be split to their respective Kitchen/Bar printers instead of all printing to the same printer.">
                    <field name="pos_ridhira_explode_combos_in_kitchen"/>
                </setting>
                <setting string="Kitchen Order Number Style" help="Customize the font size (%) and bold weight for the Order Number printed on kitchen receipts.">
                    <div class="content-group">
                        <div class="row mt16">
                            <label for="pos_kitchen_order_font_size" class="col-lg-3 o_light_label"/>
                            <field name="pos_kitchen_order_font_size"/>
                        </div>
                        <div class="row">
                            <label for="pos_kitchen_order_is_bold" class="col-lg-3 o_light_label"/>
                            <field name="pos_kitchen_order_is_bold"/>
                        </div>
                    </div>
                </setting>
                <setting string="Kitchen Item Style" help="Customize the font size and bold weight for the Food Items printed on kitchen receipts.">
                    <div class="content-group">
                        <div class="row mt16">
                            <label for="pos_kitchen_item_font_size" class="col-lg-3 o_light_label"/>
                            <field name="pos_kitchen_item_font_size"/>
                        </div>
                        <div class="row">
                            <label for="pos_kitchen_item_is_bold" class="col-lg-3 o_light_label"/>
                            <field name="pos_kitchen_item_is_bold"/>
                        </div>
                    </div>
                </setting>
                <setting string="Kitchen Extra Style" help="Customize the font size and bold weight for the Food Extras/Sides printed on kitchen receipts.">
                    <div class="content-group">
                        <div class="row mt16">
                            <label for="pos_kitchen_extra_font_size" class="col-lg-3 o_light_label"/>
                            <field name="pos_kitchen_extra_font_size"/>
                        </div>
                        <div class="row">
                            <label for="pos_kitchen_extra_is_bold" class="col-lg-3 o_light_label"/>
                            <field name="pos_kitchen_extra_is_bold"/>
                        </div>
                    </div>
                </setting>
                <setting string="Queue Numbering Mode" help="Select the queue numbering behavior for this POS. Replaces long Order References with short Daily Queue Numbers on Receipts and KDS.">
                    <field name="pos_queue_number_mode"/>
                </setting>
                <setting string="Table Tent (Seating Tracker)" help="Enable the 'Assign Table Tent' button to type in plastic tent numbers for dine-in orders. Prints 'Seating: X' on receipts and KDS.">
                    <field name="pos_enable_table_tent"/>
                </setting>
                <setting string="Customer Receipt Style" help="Customize the font size and bold weight for the Customer Receipt.">
                    <div class="content-group">
                        <div class="row mt16">
                            <label for="pos_customer_receipt_font_size" class="col-lg-3 o_light_label"/>
                            <field name="pos_customer_receipt_font_size"/>
                        </div>
                        <div class="row">
                            <label for="pos_customer_receipt_is_bold" class="col-lg-3 o_light_label"/>
                            <field name="pos_customer_receipt_is_bold"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
