<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_printer_form_inherit_ridhira" model="ir.ui.view">
        <field name="name">pos.printer.form.inherit.ridhira</field>
        <field name="model">pos.printer</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_printer_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='printer_type']" position="after">
                <field name="is_label_printer" widget="boolean_toggle"/>
                <field name="label_width" invisible="not is_label_printer"/>
                <field name="label_height" invisible="not is_label_printer"/>
            </xpath>
        </field>
    </record>
</odoo>
